{
  "name": "fiscal-year-calendar",
  "version": "3.2.1",
  "description": "A library to generate fiscal year calendar based on custom fiscal year start date",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    },
    "./calendar": {
      "import": "./dist/esm/calendar/index.js",
      "require": "./dist/cjs/calendar/index.js",
      "types": "./dist/cjs/calendar/index.d.ts"
    },
    "./utils": {
      "import": "./dist/esm/utils/index.js",
      "require": "./dist/cjs/utils/index.js",
      "types": "./dist/cjs/utils/index.d.ts"
    },
    "./types": {
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.js",
      "types": "./dist/cjs/types/index.d.ts"
    }
  },
  "keywords": [
    "customized fiscal year calendar",
    "financial year calendar",
    "4-4-5 calendar",
    "4-5-4 calendar",
    "5-4-4 calendar",
    "fiscal year",
    "financial year"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "jest --config jest.config.js",
    "prepare": "npm run build",
    "lint": "eslint . --ext .js,.ts",
    "coverage": "jest --config jest.config.js --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yc5518/fiscal_year_calendar.git"
  },
  "author": "Chao <yc5518@hotmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yc5518/fiscal_year_calendar/issues"
  },
  "homepage": "https://github.com/yc5518/fiscal_year_calendar#readme",
  "dependencies": {
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0"
  },
  "peerDependencies": {
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^6.7.4",
    "babel-core": "^6.26.3",
    "babel-eslint": "^10.0.1",
    "babel-jest": "^30.0.4",
    "babel-loader": "^10.0.0",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "babel-polyfill": "^6.9.1",
    "babel-preset-env": "^1.7.0",
    "babel-preset-react": "^6.11.1",
    "babel-preset-stage-2": "^6.24.1",
    "babel-register": "^6.9.0",
    "eslint": "^8.50.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "esm": "^3.2.25",
    "jest": "^29.7.0",
    "json-loader": "^0.5.7",
    "regenerator-runtime": "^0.14.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}
